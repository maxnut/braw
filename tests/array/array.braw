fn arr_simple() -> int {
    let arr[5]: int*;
    arr[2] = 1;
    return arr[2];
}

fn arr_ptr() -> int {
    let arr[5]: int*;
    arr[2] = 1;
    let ptr: int* = arr;
    return ptr[2];
}

struct V {
    arr[5]: int*;
};

fn arr_in_struct() -> int {
    let v: V;
    v.arr[2] = 1;
    return v.arr[2];
}
