fn i_ptr() -> int {
    let a: int = 0;
    let ptr: int* = &a;
    a = 1;
    return *ptr;
}

fn f_ptr() -> float {
    let a: float = 0.f;
    let ptr: float* = &a;
    a = 1.f;
    return *ptr;
}

struct V {
    a: int;
};

fn s_ptr() -> int {
    let v: V;
    v.a = 0;
    let ptr: V* = &v;
    v.a = 1;
    return ptr->a;
}

fn i_assign() -> int {
    let a: int = 2;
    let ptr: int* = &a;
    *ptr = 1;
    return a;
}

fn f_assign() -> float {
    let a: float = 2.f;
    let ptr: float* = &a;
    *ptr = 1.f;
    return a;
}

fn s_assign() -> int {
    let v: V;
    v.a = 2;
    let ptr: V* = &v;
    ptr->a = 1;
    return v.a;
}