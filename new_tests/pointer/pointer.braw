fn ptr_i_ptr() -> int {
    let a: int = 0;
    let ptr: int* = &a;
    a = 1;
    return *ptr;
}

fn ptr_f_ptr() -> float {
    let a: float = 0.f;
    let ptr: float* = &a;
    a = 1.f;
    return *ptr;
}

struct PV {
    a: int;
};

fn ptr_s_ptr() -> int {
    let v: PV;
    v.a = 0;
    let ptr: PV* = &v;
    v.a = 1;
    return ptr->a;
}

fn ptr_i_assign() -> int {
    let a: int = 2;
    let ptr: int* = &a;
    *ptr = 1;
    return a;
}

fn ptr_f_assign() -> float {
    let a: float = 2.f;
    let ptr: float* = &a;
    *ptr = 1.f;
    return a;
}

fn ptr_s_assign() -> int {
    let v: PV;
    v.a = 2;
    let ptr: PV* = &v;
    ptr->a = 1;
    return v.a;
}